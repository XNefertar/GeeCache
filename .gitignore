# --- 1. 编译产物 (Build Output) ---
# 忽略 Windows 下的可执行文件
*.exe
*.dll
*.so
*.dylib
*.a
*.o

# 忽略 C++ 构建目录
cpp/build/
cpp/lsm/build/
cpp/lsm/cmake-build-*/
build/

# 忽略测试生成的二进制文件
*.test

# 忽略代码覆盖率报告
*.out
coverage.txt

# 忽略编译生成的主程序文件名
geecache
main
/bin/
/dist/

# --- 2. 依赖目录 (Dependencies) ---
vendor/

# --- 3. 编辑器/IDE 配置 (IDE Config) ---
# VS Code
.vscode/

# GoLand / IntelliJ
.idea/
*.iml

# Vim 临时文件
*.swp

# --- 4. 操作系统文件 (OS) ---
# Mac 系统产生的垃圾文件
.DS_Store

# --- 5. 敏感信息 (Secrets) ---
.env

# --- 6. 运行时数据和日志 (Runtime Data & Logs) ---
*.log
*.prof
*.pprof

*.log
test_db/
data/

# --- 7. 性能分析 (Performance Analysis) ---
perf.data
perf.data.old
out.perf
out.collapsed
*.svg
stackcollapse-perf.pl
flamegraph.pl

# --- 8. 临时文件 (Temporary Files) ---
*.patch
go/bench_main

# --- 9. VS Code Counter 文件(VS Code Counter Files) ---
.VSCodeCounter/

# Ignore compiled binaries / 忽略编译后的二进制文件
go/observability_demo
go/server